game=("${initBoard[@]}")
function play {
    showBoard $game
    #showMoves "58kb" $game

    #local result=($(move "58kb" "47" $game))
    local playPiece
    local playPos
    vared -p 'Enter the piece to move: ' playPiece
    vared -p 'enter the position to move to: ' playPos
    local result=($(move $playPiece $playPos $game))
    if [[ $? -eq 0 ]]; then
        # Find index of ::: separator
        local splitIndex=0
        for ((i=1; i<${#result[@]}; i++)); do
            if [[ ${result[$i]} == ":::" ]]; then
                splitIndex=$i
                break
            fi
        done

        # Assign board and turn
        game=("${result[@]:0:$splitIndex}")
        turn="${result[$((splitIndex + 1))]}"
    else
        echo "$result"
    fi

    #showMoves "43kb" $game
    play
}
play
